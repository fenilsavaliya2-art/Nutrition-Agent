# =============================================================
#  Nutrition Agentic AI — .gitignore
# =============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
*.pyc

# ── Virtual environments ─────────────────────────────────────
venv/
.venv/
env/
ENV/
.env.local
nutrition_ai/venv/
nutrition_ai/.venv/

# ── Environment / Secrets — NEVER commit these ───────────────
.env
nutrition_ai/.env
*.env
!.env.example
!nutrition_ai/.env.example

# ── Distribution / Build ─────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/
pip-wheel-metadata/
share/python-wheels/

# ── Pytest / Testing ─────────────────────────────────────────
.pytest_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
nosetests.xml
test-results/

# ── Type checking ────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ── IDEs & Editors ───────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── Flask / Server ───────────────────────────────────────────
instance/
.webassets-cache
flask_session/

# ── Saved nutrition plans (user-generated, not source code) ──
nutrition_ai/saved_plans/*.md
# Keep the sample plan for demo purposes:
!nutrition_ai/saved_plans/nutrition_plan_demo_user_sample.md
# Keep the .gitkeep so the folder is tracked:
!nutrition_ai/saved_plans/.gitkeep

# ── Jupyter Notebooks ────────────────────────────────────────
.ipynb_checkpoints
*.ipynb

# ── Temporary files ──────────────────────────────────────────
*.tmp
*.bak
*.orig
*.rej
tmp/
temp/
